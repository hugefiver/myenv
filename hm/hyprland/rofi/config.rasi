configuration {
  modi: "drun,window,run";
  show-icons: true;
  icon-theme: "Fluent-dark";
  font: "Noto Sans 12";
  terminal: "wezterm";
  drun-display-format: "{name}";
  window-format: "{w} · {c} · {t}";
  sort: true;
  sorting-method: "normal";
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: "";
}

* {
  bg: rgba(28, 28, 36, 0.88);
  bg-alt: rgba(255, 255, 255, 0.04);
  fg: #e8e8ec;
  muted: #888996;
  border: rgba(255, 255, 255, 0.06);
  selected: rgba(96, 165, 250, 0.18);
  selected-border: rgba(96, 165, 250, 0.4);
  urgent: #f87171;
  accent: #60a5fa;
  font: "Noto Sans 12";
}

window {
  location: center;
  width: 42%;
  border: 1px;
  border-color: @border;
  border-radius: 14px;
  background-color: @bg;
}

mainbox {
  spacing: 8px;
  padding: 14px;
  background-color: transparent;
}

inputbar {
  padding: 14px 16px;
  border: 0;
  border-radius: 10px;
  background-color: @bg-alt;
  margin: 0 0 4px 0;
  children: [ prompt, entry ];
}

prompt {
  text-color: @accent;
  str: "󰍉";
  margin: 0 10px 0 0;
}

entry {
  text-color: @fg;
  placeholder-color: @muted;
  placeholder: "搜索应用、窗口或命令";
}

listview {
  lines: 8;
  columns: 1;
  fixed-height: false;
  scrollbar: false;
  padding: 4px 0;
}

element {
  padding: 10px 14px;
  border-radius: 10px;
  border: 1px;
  border-color: transparent;
}

element selected {
  background-color: @selected;
  border-color: @selected-border;
  text-color: @fg;
}

element-text {
  text-color: inherit;
}

element-icon {
  size: 1.3em;
  margin: 0 10px 0 2px;
}

message {
  enabled: false;
}
