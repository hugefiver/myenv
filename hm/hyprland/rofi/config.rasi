configuration {
  modi: "drun,window,run";
  show-icons: true;
  icon-theme: "Fluent-dark";
  font: "Noto Sans 12";
  terminal: "wezterm";
  drun-display-format: "{name}";
  window-format: "{w} · {c} · {t}";
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: "";
}

* {
  bg: rgba(26, 26, 34, 0.92);
  bg-alt: rgba(255, 255, 255, 0.06);
  fg: #e4e4e8;
  muted: #9a9aa6;
  border: rgba(255, 255, 255, 0.08);
  selected: #60a5fa;
  urgent: #f87171;
  accent: #60a5fa;
  font: "Noto Sans 12";
}

window {
  location: center;
  width: 42%;
  border: 1px;
  border-color: @border;
  border-radius: 12px;
  background-color: @bg;
}

mainbox {
  spacing: 8px;
  padding: 14px;
  background-color: transparent;
}

inputbar {
  padding: 12px;
  border: 0 0 1px 0;
  border-color: @bg-alt;
  children: [ prompt, entry ];
}

prompt {
  text-color: @accent;
  str: "󰍉";
  margin: 0 10px 0 0;
}

entry {
  text-color: @fg;
  placeholder-color: @muted;
  placeholder: "搜索应用、窗口或命令";
}

listview {
  lines: 8;
  columns: 1;
  fixed-height: false;
  scrollbar: false;
  padding: 4px 0;
}

element {
  padding: 10px 12px;
  border-radius: 8px;
}

element selected {
  background-color: @bg-alt;
  text-color: @fg;
}

element-text {
  text-color: inherit;
}

element-icon {
  size: 1.3em;
  margin: 0 10px 0 2px;
}

message {
  enabled: false;
}
