# Intel iGPU 作为主渲染 GPU，动态发现所有 DisplayLink（evdi）输出设备。
# UWSM 在启动 Hyprland 前 source 此文件。

_igpu_real=$(readlink -f /dev/dri/intel-igpu 2>/dev/null || echo "")
_devs="/dev/dri/intel-igpu"
for _c in /dev/dri/card*; do
  [ ! -e "$_c" ] && continue
  _real=$(readlink -f "$_c")
  [ "$_real" = "$_igpu_real" ] && continue
  _devs="$_devs:$_c"
done
export AQ_DRM_DEVICES="$_devs"

export AQ_MGPU_NO_EXPLICIT=1
export WLR_NO_HARDWARE_CURSORS=1
