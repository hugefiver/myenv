{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 4,
  "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["group/hardware", "group/status", "tray", "custom/power"],

  "custom/launcher": {
    "format": "",
    "tooltip": false,
    "on-click": "rofi -show drun -show-icons"
  },

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
    },
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "active": "",
      "default": ""
    }
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 48,
    "separate-outputs": true
  },

  "clock": {
    "format": "󰥔 {:%a %m-%d  %H:%M}",
    "format-alt": "󰃭 {:%Y-%m-%d}",
    "tooltip-format": "<big>{:%Y年%m月%d日 %A}</big>\n<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "today": "<span color='#f38ba8'><b>{}</b></span>"
      }
    }
  },

  "group/hardware": {
    "orientation": "inherit",
    "modules": ["cpu", "memory", "temperature"]
  },

  "group/status": {
    "orientation": "inherit",
    "modules": ["pulseaudio", "network", "battery"]
  },

  "cpu": {
    "interval": 3,
    "format": " {usage}%",
    "tooltip": true
  },

  "memory": {
    "interval": 5,
    "format": " {}%",
    "tooltip-format": "内存占用 {used:0.1f}G / {total:0.1f}G"
  },

  "temperature": {
    "critical-threshold": 80,
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["", "", "", "", ""]
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 mute",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },

  "network": {
    "interval": 3,
    "format-wifi": " {essid}",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-linked": "󰈀 {ifname}",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid}\n信号: {signalStrength}%\nIP: {ipaddr}/{cidr}\n频率: {frequency}MHz",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
    "on-click": "wezterm start --always-new-process -- nmtui",
    "on-click-right": "nm-connection-editor"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-full": "󰁹",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "tray": {
    "icon-size": 15,
    "spacing": 6
  },

  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "wlogout"
  }
}
