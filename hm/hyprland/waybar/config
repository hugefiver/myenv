[
{
  "layer": "top",
  "position": "top",
  "output": "DVI-I-1",
  "height": 24,
  "margin-top": 2,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 4,
  "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["group/hardware", "group/status", "bluetooth", "tray", "custom/power"],

  "custom/launcher": {
    "format": "󱄅",
    "tooltip": false,
    "on-click": "~/.config/hypr/scripts/rofi-launcher.sh"
  },

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{name}",
"persistent-workspaces": {
"desc:Dell Inc. DELL U2720QM 60PZCH3": [1, 2, 3, 4, 5, 6, 7]
    }
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 48,
    "separate-outputs": true
  },

  "clock": {
    "locale": "zh_CN.UTF-8",
    "format": "󰥔 {:%m月%d日 %H:%M %a}",
    "format-alt": "󰃭 {:%Y年%m月%d日 %A}",
    "tooltip-format": "<big>{:%Y年%-m月%-d日 %A}</big>\n<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "today": "<span color='#f38ba8'><b>{}</b></span>"
      }
    }
  },

  "group/hardware": {
    "orientation": "inherit",
    "modules": ["cpu", "memory", "temperature"]
  },

  "group/status": {
    "orientation": "inherit",
    "modules": ["pulseaudio", "network", "battery"]
  },

  "cpu": {
    "interval": 3,
    "format": "󰻠 {usage}%",
    "tooltip": true
  },

  "memory": {
    "interval": 5,
    "format": "󰍛 {}%",
    "tooltip-format": "内存占用 {used:0.1f}G / {total:0.1f}G"
  },

  "temperature": {
    "critical-threshold": 80,
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["󰹖", "󰹖", "󰔏", "󰹔", "󰹕"]
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 mute",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol"
  },

  "network": {
    "interval": 3,
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-linked": "󰈀 {ifname}",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid}\n信号: {signalStrength}%\nIP: {ipaddr}/{cidr}\n频率: {frequency}MHz",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
    "on-click": "nm-connection-editor"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-full": "󰁹",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} 已连接",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} 已连接\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "blueman-manager"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 5
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "~/.config/hypr/scripts/power-menu.sh"
  }
},
{
  "layer": "top",
  "position": "top",
  "output": "DVI-I-2",
  "height": 24,
  "margin-top": 2,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": [],
  "modules-right": [],

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{name}",
"persistent-workspaces": {
"desc:Dell Inc. DELL U2720QM FCV0DH3": [8, 9, 10]
    }
  }
}
]
