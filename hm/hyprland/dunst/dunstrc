[global]
font = Noto Sans 11
markup = full
format = <b>%s</b>\n%b
icon_theme = Fluent-dark
alignment = left
vertical_alignment = center
show_age_threshold = 60
word_wrap = yes
ignore_newline = no
follow = mouse
width = (340, 440)
height = 280
origin = top-right
offset = 16x16
corner_radius = 14
frame_width = 1
frame_color = "rgba(219, 175, 110, 10)"
separator_color = frame
padding = 14
horizontal_padding = 14
text_icon_padding = 12
transparency = 0
background = "#2a2520ee"
foreground = "#e6ddd4"
progress_bar = true
progress_bar_height = 8
progress_bar_corner_radius = 4
progress_bar_frame_width = 0
progress_bar_min_width = 120
progress_bar_max_width = 240
notification_limit = 8
stack_duplicates = true
browser = falkon
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

[urgency_low]
background = "#2a2520ee"
foreground = "#968b80"
frame_color = "rgba(219, 175, 110, 10)"
timeout = 4

[urgency_normal]
background = "#2a2520ee"
foreground = "#e6ddd4"
frame_color = "#dba86b"
timeout = 6

[urgency_critical]
background = "#2a2520ee"
foreground = "#fcd34d"
frame_color = "#f28b82"
timeout = 0
