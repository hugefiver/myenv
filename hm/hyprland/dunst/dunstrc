[global]
font = CaskaydiaCove Nerd Font Mono 11
markup = full
format = <b>%s</b>\n%b
icon_theme = breeze-dark
alignment = left
vertical_alignment = center
show_age_threshold = 60
word_wrap = yes
ignore_newline = no
follow = mouse
width = (340, 440)
height = 280
origin = top-right
offset = 16x16
corner_radius = 10
frame_width = 1
frame_color = "rgba(255, 255, 255, 15)"
separator_color = frame
padding = 14
horizontal_padding = 14
text_icon_padding = 12
transparency = 0
background = "#1a1a22ee"
foreground = "#e4e4e8"
progress_bar = true
progress_bar_height = 8
progress_bar_corner_radius = 4
progress_bar_frame_width = 0
progress_bar_min_width = 120
progress_bar_max_width = 240
notification_limit = 8
stack_duplicates = true
browser = falkon
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

[urgency_low]
background = "#24242cee"
foreground = "#b0b0ba"
frame_color = "rgba(255, 255, 255, 15)"
timeout = 4

[urgency_normal]
background = "#24242cee"
foreground = "#e4e4e8"
frame_color = "#60a5fa"
timeout = 6

[urgency_critical]
background = "#24242cee"
foreground = "#fcd34d"
frame_color = "#f87171"
timeout = 0
