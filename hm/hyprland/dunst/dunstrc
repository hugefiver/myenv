[global]
font = CaskaydiaCove Nerd Font Mono 11
markup = full
format = <b>%s</b>\n%b
icon_theme = breeze-dark
alignment = left
vertical_alignment = center
show_age_threshold = 60
word_wrap = yes
ignore_newline = no
follow = mouse
width = (340, 460)
height = 300
origin = top-right
offset = 24x24
corner_radius = 18
frame_width = 2
frame_color = "#89b4fa"
separator_color = frame
padding = 16
horizontal_padding = 16
text_icon_padding = 14
transparency = 0
background = "#11111bee"
foreground = "#dde4ff"
progress_bar = true
progress_bar_height = 10
progress_bar_corner_radius = 8
progress_bar_frame_width = 0
progress_bar_min_width = 120
progress_bar_max_width = 260
notification_limit = 8
stack_duplicates = true
browser = falkon
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

[urgency_low]
background = "#1e1e2eee"
foreground = "#cdd6f4"
frame_color = "#89dceb"
timeout = 4

[urgency_normal]
background = "#1e1e2eee"
foreground = "#dde4ff"
frame_color = "#89b4fa"
timeout = 6

[urgency_critical]
background = "#1e1e2eee"
foreground = "#f9e2af"
frame_color = "#f38ba8"
timeout = 0
